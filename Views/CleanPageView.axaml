<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinButler.ViewModels"
             xmlns:conv="using:WinButler.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="WinButler.Views.CleanPageView"
             x:DataType="vm:CleanPageViewModel">

    <UserControl.Resources>
        <conv:RiskColorConverter x:Key="RiskColor"/>
    </UserControl.Resources>

    <DockPanel Margin="20">

        <!-- Action bar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="Clean" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Scan" Command="{Binding ScanCommand}" Classes="primary" Width="100"/>
            <Button Content="Clean Selected" Command="{Binding CleanSelectedCommand}" Width="140"/>
            <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
        </StackPanel>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedSummary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Categories -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryViewModel">
                        <Expander Margin="0,4" IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"/>
                            </Expander.Header>

                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Select all" Command="{Binding SelectAllCommand}"/>
                                    <Button Content="Select none" Command="{Binding SelectNoneCommand}"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CleanupTargetViewModel">
                                            <Border BorderBrush="#22808080" BorderThickness="0,0,0,1" Padding="4,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Reason}" FontSize="11" Opacity="0.7"/>
                                                        <TextBlock Text="{Binding FullPath}" FontSize="10" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" VerticalAlignment="Center"
                                                            Background="{Binding Risk, Converter={StaticResource RiskColor}}"
                                                            CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding RiskText}" Foreground="White" FontSize="11"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="3" Text="{Binding DeleteModeText}"
                                                               FontSize="11" Opacity="0.7" VerticalAlignment="Center" Width="95"/>

                                                    <TextBlock Grid.Column="4" Text="{Binding SizeText}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" Width="80" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
