<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinButler.ViewModels"
             xmlns:models="using:WinButler.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="WinButler.Views.RedirectPageView"
             x:Name="Root"
             x:DataType="vm:RedirectPageViewModel">

    <DockPanel Margin="20">

        <!-- Action bar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <TextBlock Text="Redirect" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="Move to drive:" VerticalAlignment="Center"/>
            <ui:FAComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" MinWidth="80"/>
            <Button Content="Scan" Command="{Binding ScanCommand}" Theme="{DynamicResource AccentButtonTheme}" Width="90"/>
            <Button Content="Redirect Selected" Command="{Binding RedirectSelectedCommand}" Width="150"/>
            <ProgressBar IsIndeterminate="True" Width="100" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
        </StackPanel>

        <ui:FAInfoBar DockPanel.Dock="Top" IsOpen="True" IsClosable="False"
                      Severity="Informational" Title="How redirection works"
                      Message="Selected folders are copied to &lt;drive&gt;:\_redirected, verified, then replaced with a directory junction so apps keep working. Use Undo to move them back."
                      Margin="0,0,0,8"/>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <ScrollViewer>
            <StackPanel Spacing="16">

                <!-- Candidates -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Redirectable folders" FontWeight="SemiBold" FontSize="16"/>
                    <ItemsControl ItemsSource="{Binding Candidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RedirectCandidateViewModel">
                                <Border BorderBrush="#22808080" BorderThickness="0,0,0,1" Padding="4,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding CanRedirect}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7"/>
                                            <TextBlock Text="{Binding SourcePath}" FontSize="10" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" VerticalAlignment="Center" Background="#33808080"
                                                CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Category}" FontSize="11"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Width="80" TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Active redirects -->
                <StackPanel Spacing="4" IsVisible="{Binding HasActiveRedirects}">
                    <TextBlock Text="Active redirects" FontWeight="SemiBold" FontSize="16"/>
                    <ItemsControl ItemsSource="{Binding ActiveRedirects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RedirectRecord">
                                <Border BorderBrush="#22808080" BorderThickness="0,0,0,1" Padding="4,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourcePath}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TargetPath}" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Undo"
                                                Command="{Binding #Root.((vm:RedirectPageViewModel)DataContext).UndoCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
