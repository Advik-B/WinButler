<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinButler.ViewModels"
             xmlns:models="using:WinButler.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="WinButler.Views.RedirectPageView"
             x:Name="Root"
             x:DataType="vm:RedirectPageViewModel"
             Background="{DynamicResource WbBgBrush}">

    <DockPanel Margin="28,24">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel Grid.Column="0">
                <TextBlock Text="SPACE · DIRECTORY JUNCTIONS" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                           FontSize="{StaticResource WbText2xs}" LetterSpacing="2"
                           Foreground="{DynamicResource WbAccentBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Redirect to another drive" FontFamily="{DynamicResource WbFontDot}" FontWeight="Bold"
                           FontSize="{StaticResource WbTextXl}" Foreground="{DynamicResource WbTextBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <TextBlock Text="Move to drive:" VerticalAlignment="Center" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                           FontSize="{StaticResource WbTextXs}" Foreground="{DynamicResource WbTextTertiaryBrush}"/>
                <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" MinWidth="70"/>
                <Button Content="SCAN" Command="{Binding ScanCommand}" Classes="primary"/>
                <Button Content="REDIRECT SELECTED" Command="{Binding RedirectSelectedCommand}" Classes="secondary"/>
                <ProgressBar IsIndeterminate="True" Width="90" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Background="{DynamicResource WbSurfaceInsetBrush}"
                BorderBrush="{DynamicResource WbBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource WbRadiusMd}" Padding="14" Margin="0,0,0,10">
            <StackPanel Spacing="3">
                <TextBlock Text="How redirection works" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                           FontSize="{StaticResource WbTextXs}" Foreground="{DynamicResource WbTextBrush}"/>
                <TextBlock TextWrapping="Wrap" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold" FontSize="{StaticResource WbText2xs}"
                           Foreground="{DynamicResource WbTextSecondaryBrush}"
                           Text="Selected folders are copied to &lt;drive&gt;:\_redirected, verified, then replaced with a directory junction so apps keep working. Use Undo to move them back."/>
            </StackPanel>
        </Border>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,12,0,0"
                   FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold" FontSize="{StaticResource WbTextXs}"
                   Foreground="{DynamicResource WbTextTertiaryBrush}"/>

        <ScrollViewer>
            <StackPanel Spacing="18">

                <!-- Candidates -->
                <StackPanel Spacing="8">
                    <TextBlock Text="RELOCATABLE FOLDERS" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                               FontSize="{StaticResource WbText2xs}" LetterSpacing="1.5"
                               Foreground="{DynamicResource WbTextMutedBrush}"/>
                    <Border BorderBrush="{DynamicResource WbBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource WbRadiusMd}" Background="{DynamicResource WbSurfaceBrush}"
                            ClipToBounds="True">
                        <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RedirectCandidateViewModel">
                                    <Border BorderBrush="{DynamicResource WbBorderFaintBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource WbSurface2Brush}"/>
                                            </Style>
                                        </Border.Styles>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding CanRedirect}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <TextBlock Text="{Binding DisplayName}" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                                                               FontSize="{StaticResource WbTextSm}" Foreground="{DynamicResource WbTextBrush}"/>
                                                    <TextBlock Text="{Binding SourcePath}" FontFamily="{DynamicResource WbFontReadout}"
                                                               FontSize="{StaticResource WbText2xs}" Foreground="{DynamicResource WbTextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusText}" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                                                           FontSize="{StaticResource WbText2xs}" Foreground="{DynamicResource WbTextTertiaryBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center" Background="{DynamicResource WbSurfaceInsetBrush}"
                                                    CornerRadius="{StaticResource WbRadiusPill}" Padding="9,3">
                                                <TextBlock Text="{Binding Category}" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                                                           FontSize="{StaticResource WbText2xs}" Foreground="{DynamicResource WbTextTertiaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontFamily="{DynamicResource WbFontReadout}"
                                                       VerticalAlignment="Center" Width="70" TextAlignment="Right"
                                                       Foreground="{DynamicResource WbTextBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Active redirects -->
                <StackPanel Spacing="8" IsVisible="{Binding HasActiveRedirects}">
                    <TextBlock Text="ACTIVE JUNCTIONS" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                               FontSize="{StaticResource WbText2xs}" LetterSpacing="1.5"
                               Foreground="{DynamicResource WbTextMutedBrush}"/>
                    <ItemsControl ItemsSource="{Binding ActiveRedirects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RedirectRecord">
                                <Border BorderBrush="{DynamicResource WbAccentTintBrush}" BorderThickness="1"
                                        Background="{DynamicResource WbAccentTintBrush}"
                                        CornerRadius="{StaticResource WbRadiusSm}" Padding="14,10" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourcePath}" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                                                       FontSize="{StaticResource WbTextXs}" Foreground="{DynamicResource WbTextBrush}"/>
                                            <TextBlock Text="{Binding TargetPath}" FontFamily="{DynamicResource WbFontReadout}"
                                                       FontSize="{StaticResource WbText2xs}" Foreground="{DynamicResource WbAccentBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="UNDO" Classes="ghost"
                                                Command="{Binding #Root.((vm:RedirectPageViewModel)DataContext).UndoCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
