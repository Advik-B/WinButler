<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinButler.ViewModels"
             xmlns:shared="using:WinButler.Views.Shared"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="WinButler.Views.DashboardPageView"
             x:DataType="vm:DashboardPageViewModel"
             Background="{DynamicResource WbBgBrush}">

    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="18" MaxWidth="1180">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SYSTEM OVERVIEW" FontFamily="{DynamicResource WbFontUi}"
                               FontSize="{StaticResource WbText2xs}" LetterSpacing="2"
                               Foreground="{DynamicResource WbAccentBrush}" Margin="0,0,0,7"/>
                    <TextBlock Text="Dashboard" FontFamily="{DynamicResource WbFontDot}" FontWeight="Bold"
                               FontSize="{StaticResource WbText2xl}" Foreground="{DynamicResource WbTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="⚡ CLEAN ALL" Classes="primary" VerticalAlignment="Bottom"
                        Command="{Binding CleanAllCommand}"/>
            </Grid>

            <!-- DISK HERO -->
            <Border BorderBrush="{DynamicResource WbBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource WbRadiusLg}" Background="{DynamicResource WbSurfaceBrush}"
                    Padding="22,20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" MinWidth="420" Margin="0,0,26,0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,11">
                            <TextBlock Grid.Column="0" FontFamily="{DynamicResource WbFontUi}" FontSize="{StaticResource WbTextXs}"
                                       Foreground="{DynamicResource WbTextTertiaryBrush}">
                                <Run Text="{Binding DriveLabel}"/><Run Text="  ·  System Drive"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontFamily="{DynamicResource WbFontReadout}" FontSize="{StaticResource WbTextXs}"
                                       Foreground="{DynamicResource WbTextSecondaryBrush}">
                                <Run Text="{Binding DiskUsedText}"/><Run Text=" used of "/><Run Text="{Binding DiskTotalText}"/>
                            </TextBlock>
                        </Grid>
                        <Border Height="30" CornerRadius="7" BorderBrush="{DynamicResource WbBorderBrush}" BorderThickness="1"
                                Background="{DynamicResource WbInk600Brush}" ClipToBounds="True">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ReclaimablePercent}"
                                         Height="30" CornerRadius="0" Background="Transparent"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,13,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource WbInk600Brush}"/>
                                <TextBlock Text="System &amp; apps" FontFamily="{DynamicResource WbFontUi}" FontSize="{StaticResource WbText2xs}"
                                           Foreground="{DynamicResource WbTextTertiaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource WbAccentBrush}"/>
                                <TextBlock Text="Reclaimable" FontFamily="{DynamicResource WbFontUi}" FontSize="{StaticResource WbText2xs}"
                                           Foreground="{DynamicResource WbTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="26">
                        <StackPanel>
                            <TextBlock Text="{Binding ToReclaimNowText}" FontFamily="{DynamicResource WbFontReadout}"
                                       FontWeight="Bold" FontSize="{StaticResource WbText3xl}" Foreground="{DynamicResource WbAccentBrush}"/>
                            <TextBlock Text="TO RECLAIM NOW" FontFamily="{DynamicResource WbFontUi}" FontSize="{StaticResource WbText2xs}"
                                       LetterSpacing="1.5" Foreground="{DynamicResource WbTextTertiaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding ToRedirectText}" FontFamily="{DynamicResource WbFontReadout}"
                                       FontWeight="Bold" FontSize="{StaticResource WbText3xl}" Foreground="{DynamicResource WbTextBrush}"/>
                            <TextBlock Text="TO REDIRECT" FontFamily="{DynamicResource WbFontUi}" FontSize="{StaticResource WbText2xs}"
                                       LetterSpacing="1.5" Foreground="{DynamicResource WbTextTertiaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CATEGORY CARDS -->
            <ItemsControl ItemsSource="{Binding CategoryCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryCardInfo">
                        <shared:CategoryCardView Margin="0,0,12,0" IconGlyph="{Binding IconGlyph}"
                                                  Title="{Binding Title}" SizeText="{Binding SizeText}"
                                                  CountText="{Binding CountText}" BarPercent="{Binding BarPercent}"
                                                  ClickCommand="{Binding ClickCommand}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- REDIRECT HIGHLIGHT + ACTIVITY -->
            <Grid ColumnDefinitions="1.55*,1*" >
                <Button Grid.Column="0" Classes="secondary" Margin="0,0,12,0" Padding="20"
                        HorizontalContentAlignment="Stretch" CornerRadius="{StaticResource WbRadiusMd}"
                        Command="{Binding GoToRedirectCommand}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" MaxWidth="380">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource WbAccentBrush}"/>
                                <TextBlock Text="SIGNATURE FEATURE" FontFamily="{DynamicResource WbFontUi}" FontSize="{StaticResource WbText2xs}"
                                           LetterSpacing="1.5" Foreground="{DynamicResource WbAccentBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Redirect to another drive" FontFamily="{DynamicResource WbFontDot}" FontWeight="Bold"
                                       FontSize="{StaticResource WbTextLg}" Foreground="{DynamicResource WbTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontFamily="{DynamicResource WbFontUi}" FontSize="{StaticResource WbTextXs}"
                                       Foreground="{DynamicResource WbTextSecondaryBrush}"
                                       Text="Move heavy dev folders via directory junctions. Apps still see them at C:\ — zero broken paths."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding RedirectableGb}" FontFamily="{DynamicResource WbFontReadout}" FontWeight="Bold"
                                       FontSize="{StaticResource WbTextXl}" Foreground="{DynamicResource WbAccentBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="RELOCATABLE" FontFamily="{DynamicResource WbFontUi}" FontSize="{StaticResource WbText2xs}"
                                       LetterSpacing="1" Foreground="{DynamicResource WbTextTertiaryBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Border Grid.Column="1" BorderBrush="{DynamicResource WbBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource WbRadiusMd}" Background="{DynamicResource WbSurfaceBrush}"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="SESSION ACTIVITY" FontFamily="{DynamicResource WbFontUi}" FontSize="{StaticResource WbText2xs}"
                                   LetterSpacing="1.5" Foreground="{DynamicResource WbTextTertiaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock IsVisible="{Binding !HasActivity}" Text="NO SIGNAL — NOTHING CLEANED YET"
                                   FontFamily="{DynamicResource WbFontUi}" FontSize="{StaticResource WbText2xs}"
                                   LetterSpacing="1" Foreground="{DynamicResource WbTextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,18,0,18"/>
                        <ItemsControl ItemsSource="{Binding SessionActivity}" IsVisible="{Binding HasActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" FontFamily="{DynamicResource WbFontUi}" FontSize="{StaticResource WbText2xs}"
                                               Foreground="{DynamicResource WbTextSecondaryBrush}" Margin="0,0,0,8"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
