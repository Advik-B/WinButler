<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinButler.ViewModels"
             xmlns:shared="using:WinButler.Views.Shared"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:wb="using:WinButler.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="WinButler.Views.DashboardPageView"
             x:DataType="vm:DashboardPageViewModel"
             wb:Responsive.NarrowUnder="820"
             Background="{DynamicResource WbBgBrush}">

    <UserControl.Styles>
        <!-- Wide Disk Hero (default): stats dock to the right of the full-width bar. These MUST be
             style setters, not inline attributes — a local value would outrank the `.narrow`
             override below and the reflow would never fire. -->
        <Style Selector="StackPanel.stats">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="26,0,0,0"/>
        </Style>
        <!-- Narrow Disk Hero: stats reflow below the full-width bar (defined after the base style so
             it wins when both match). -->
        <Style Selector="Border.narrow StackPanel.stats">
            <Setter Property="DockPanel.Dock" Value="Bottom"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>
        <!-- Category cards: four across when wide, two when the page gets narrow (keeps the size
             readouts from clipping near the window's minimum width). -->
        <Style Selector="UniformGrid.cards">
            <Setter Property="Columns" Value="4"/>
        </Style>
        <Style Selector=":is(UserControl).narrow UniformGrid.cards">
            <Setter Property="Columns" Value="2"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="18" MaxWidth="1180">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SYSTEM · OVERVIEW" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                               FontSize="{StaticResource WbText2xs}" LetterSpacing="2"
                               Foreground="{DynamicResource WbAccentBrush}" Margin="0,0,0,7"/>
                    <TextBlock Text="Dashboard" FontFamily="{DynamicResource WbFontDot}" FontWeight="Bold"
                               FontSize="{StaticResource WbText2xl}" Foreground="{DynamicResource WbTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" VerticalAlignment="Bottom"
                        Command="{Binding CleanAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <i:Icon Value="mdi-broom" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="CLEAN ALL" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- DISK HERO — the stats dock right of the full-width bar, and reflow *below* it when
                 the card gets narrow (a `narrow` class is toggled from code-behind on width). -->
            <Border x:Name="DiskHero" BorderBrush="{DynamicResource WbBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource WbRadiusLg}" Background="{DynamicResource WbSurfaceBrush}"
                    Padding="22,20">
                <DockPanel>
                    <!-- Stats first so the disk block (last child) fills the rest and the bar stays
                         full width. Dock/margin/alignment live in the `StackPanel.stats` styles above
                         (NOT inline) so the `.narrow` style can re-dock this to Bottom. -->
                    <StackPanel Classes="stats" Orientation="Horizontal" Spacing="26">
                        <StackPanel>
                            <TextBlock Text="{Binding ToReclaimNowText}" FontFamily="{DynamicResource WbFontReadout}"
                                       FontWeight="Bold" FontSize="{StaticResource WbText2xl}" Foreground="{DynamicResource WbAccentBrush}"/>
                            <TextBlock Text="TO RECLAIM NOW" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold" FontSize="{StaticResource WbText2xs}"
                                       LetterSpacing="1.5" Foreground="{DynamicResource WbTextTertiaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding ToRedirectText}" FontFamily="{DynamicResource WbFontReadout}"
                                       FontWeight="Bold" FontSize="{StaticResource WbText2xl}" Foreground="{DynamicResource WbTextBrush}"/>
                            <TextBlock Text="TO REDIRECT" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold" FontSize="{StaticResource WbText2xs}"
                                       LetterSpacing="1.5" Foreground="{DynamicResource WbTextTertiaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel MinWidth="340">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,11">
                            <TextBlock Grid.Column="0" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold" FontSize="{StaticResource WbTextXs}"
                                       Foreground="{DynamicResource WbTextTertiaryBrush}">
                                <Run Text="{Binding DriveLabel}"/><Run Text="  ·  System Drive"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontFamily="{DynamicResource WbFontReadout}" FontSize="{StaticResource WbTextXs}"
                                       Foreground="{DynamicResource WbTextSecondaryBrush}">
                                <Run Text="{Binding DiskUsedText}"/><Run Text=" used of "/><Run Text="{Binding DiskTotalText}"/>
                            </TextBlock>
                        </Grid>
                        <!-- Used / free disk bar (from DriveInfo — always available, no scan). -->
                        <Border Height="30" CornerRadius="7" BorderBrush="{DynamicResource WbBorderBrush}" BorderThickness="1"
                                Background="{DynamicResource WbInk850Brush}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding UsedStar}"/>
                                    <ColumnDefinition Width="{Binding FreeStar}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource WbAccentBrush}"/>
                                <Border Grid.Column="1" Background="Transparent"/>
                            </Grid>
                        </Border>
                        <WrapPanel Margin="0,13,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,18,6">
                                <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource WbAccentBrush}"/>
                                <TextBlock FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold" FontSize="{StaticResource WbText2xs}" Foreground="{DynamicResource WbTextTertiaryBrush}">
                                    <Run Text="Used"/><Run Text="  "/><Run Text="{Binding DiskUsedText}" FontFamily="{DynamicResource WbFontReadout}" Foreground="{DynamicResource WbTextSecondaryBrush}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,18,6">
                                <Border Width="9" Height="9" CornerRadius="2" Background="Transparent"
                                        BorderBrush="{DynamicResource WbBorderStrongBrush}" BorderThickness="1"/>
                                <TextBlock FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold" FontSize="{StaticResource WbText2xs}" Foreground="{DynamicResource WbTextTertiaryBrush}">
                                    <Run Text="Free"/><Run Text="  "/><Run Text="{Binding DiskFreeText}" FontFamily="{DynamicResource WbFontReadout}" Foreground="{DynamicResource WbTextSecondaryBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- CATEGORY CARDS -->
            <ItemsControl ItemsSource="{Binding CategoryCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Classes="cards"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryCardInfo">
                        <shared:CategoryCardView Margin="0,0,12,12" IconGlyph="{Binding IconGlyph}"
                                                  Title="{Binding Title}" SizeText="{Binding SizeText}"
                                                  CountText="{Binding CountText}" BarPercent="{Binding BarPercent}"
                                                  ClickCommand="{Binding ClickCommand}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- REDIRECT HIGHLIGHT (full width; session activity feed removed) -->
            <Button Classes="secondary" Padding="20"
                    HorizontalContentAlignment="Stretch" CornerRadius="{StaticResource WbRadiusMd}"
                    Command="{Binding GoToRedirectCommand}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" MaxWidth="560">
                        <TextBlock Text="SIGNATURE FEATURE" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold" FontSize="{StaticResource WbText2xs}"
                                   LetterSpacing="1.5" Foreground="{DynamicResource WbAccentBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Redirect to another drive" FontFamily="{DynamicResource WbFontDot}" FontWeight="Bold"
                                   FontSize="{StaticResource WbTextLg}" Foreground="{DynamicResource WbTextBrush}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold" FontSize="{StaticResource WbTextXs}"
                                   Foreground="{DynamicResource WbTextSecondaryBrush}"
                                   Text="Move heavy dev folders via directory junctions. Apps still see them at C:\ — zero broken paths."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding RedirectableGb}" FontFamily="{DynamicResource WbFontReadout}" FontWeight="Bold"
                                   FontSize="{StaticResource WbTextXl}" Foreground="{DynamicResource WbAccentBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="RELOCATABLE" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold" FontSize="{StaticResource WbText2xs}"
                                   LetterSpacing="1" Foreground="{DynamicResource WbTextTertiaryBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Button>

        </StackPanel>
    </ScrollViewer>

</UserControl>
