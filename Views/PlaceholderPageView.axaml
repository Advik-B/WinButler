<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinButler.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="WinButler.Views.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel"
             Background="{DynamicResource WbBgBrush}">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360">
        <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"
                   FontFamily="{DynamicResource WbFontDot}" FontSize="{StaticResource WbTextXl}"
                   Foreground="{DynamicResource WbTextBrush}"/>
        <TextBlock Text="{Binding Message}" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                   FontSize="{StaticResource WbTextXs}"
                   Foreground="{DynamicResource WbTextTertiaryBrush}"/>
    </StackPanel>

</UserControl>
