<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WinButler.ViewModels"
        xmlns:shell="using:WinButler.Views.Shell"
        xmlns:shared="using:WinButler.Views.Shared"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="WinButler.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/winbutler.ico"
        Width="1180" Height="760"
        MinWidth="840" MinHeight="560"
        Background="{DynamicResource WbBgBrush}"
        Title="WinButler — Disk Cleaner">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <DockPanel>

            <!-- Menu strip + toolbar removed: the main actions (RE-SCAN, dry-run) now live in
                 the status bar below; navigation lives in the sidebar. -->

            <!-- DEFINITIONS-ERROR BANNER (fail-closed: cleaning disabled) -->
            <Border DockPanel.Dock="Top" IsVisible="{Binding HasDefinitionsError}"
                    Background="{DynamicResource WbSignalLiveBrush}" Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <i:Icon Value="mdi-alert" FontSize="15" VerticalAlignment="Center"
                            Foreground="{DynamicResource WbWhiteBrush}"/>
                    <TextBlock Text="{Binding DefinitionsError}" VerticalAlignment="Center"
                               FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold"
                               FontSize="{StaticResource WbTextXs}" Foreground="{DynamicResource WbWhiteBrush}"/>
                </StackPanel>
            </Border>

            <!-- STATUS BAR — now the app's action bar: RE-SCAN + dry-run on the left, the shell
                 progress bar (MFT parse / delete) in the center, version on the right. -->
            <Border DockPanel.Dock="Bottom" Height="44"
                    Background="{DynamicResource WbSurface2Brush}"
                    BorderBrush="{DynamicResource WbBorderFaintBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Classes="secondary" Command="{Binding RescanAllCommand}"
                                ToolTip.Tip="Re-run every page's scan">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="mdi-refresh" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="RE-SCAN" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <shared:DryRunPillView IsDryRun="{Binding Settings.IsDryRun}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding IsProgressActive}">
                        <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center"
                                   FontSize="{StaticResource WbText2xs}" Foreground="{DynamicResource WbTextSecondaryBrush}"/>
                        <ProgressBar Width="180" Height="6" VerticalAlignment="Center"
                                     Minimum="0" Maximum="1" Value="{Binding ProgressValue}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                    </StackPanel>

                    <!-- Version lives in the sidebar wordmark; the status bar keeps just the name. -->
                    <TextBlock Grid.Column="2" Text="WINBUTLER" VerticalAlignment="Center"
                               FontSize="{StaticResource WbText2xs}" Foreground="{DynamicResource WbTextMutedBrush}"/>
                </Grid>
            </Border>

            <!-- BODY: sidebar + content -->
            <Grid ColumnDefinitions="Auto,*">
                <shell:SidebarView Grid.Column="0"/>
                <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"
                                 Background="{DynamicResource WbBgBrush}"/>
            </Grid>

        </DockPanel>

        <!-- TOAST OVERLAY -->
        <Panel IsVisible="{Binding CurrentToast, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,46">
            <shared:ToastView DataContext="{Binding CurrentToast}"/>
        </Panel>

        <!-- CONFIRM MODAL OVERLAY -->
        <Panel IsVisible="{Binding PendingConfirm, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <shared:ConfirmDialogView DataContext="{Binding PendingConfirm}"/>
        </Panel>
    </Panel>

</Window>
