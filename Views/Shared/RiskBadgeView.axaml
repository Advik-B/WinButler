<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:WinButler.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="90" d:DesignHeight="20"
             x:Class="WinButler.Views.Shared.RiskBadgeView"
             x:Name="Root">

    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Ellipse Width="7" Height="7"
                 Fill="{Binding Risk, ElementName=Root, Converter={x:Static conv:RiskColorConverter.Instance}}"/>
        <TextBlock Text="{Binding Risk, ElementName=Root, Converter={x:Static conv:RiskLabelConverter.Instance}}"
                   FontFamily="{DynamicResource WbFontUi}" FontWeight="Bold" FontSize="{StaticResource WbText2xs}"
                   LetterSpacing="1" Foreground="{DynamicResource WbTextMutedBrush}"/>
    </StackPanel>

</UserControl>
